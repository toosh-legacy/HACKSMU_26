# Google Gemini API key (used by ClusteringAgent for behavioural hypotheses)
GEMINI_API_KEY=

# File paths — defaults work on Railway; override only if needed
AUDIO_DIR=rumbleos/data/recordings
CSV_PATH=rumbleos/data/timestamps.csv
OUTPUT_DIR=rumbleos/results

# SenseCAP serial port — local IoT device only, leave blank in cloud
SENSECAP_PORT=
