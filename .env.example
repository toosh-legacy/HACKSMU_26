# Google Gemini API key (used by ClusteringAgent for behavioural hypotheses)
GEMINI_API_KEY=

# File paths - these defaults match `cd rumbleos && python server.py`
AUDIO_DIR=data/recordings
CSV_PATH=data/timestamps.csv
OUTPUT_DIR=results

# SenseCAP serial port - local IoT device only, leave blank in cloud
SENSECAP_PORT=
